{
  "description": "a compiled script writes the same CSV, header included",
  "runs": [
    ["run", "--format", "csv", "--compile", "compiled.sh", "-o", "results.yuclid.csv"],
    "sh compiled.sh"
  ],
  "output_flag": false,
  "results_file": "results.yuclid.csv",
  "records": [
    {"a": "1", "always": "1", "first_only": "9"},
    {"a": "2", "always": "2", "first_only": ""}
  ],
  "file_contains": { "compiled.sh": ["printf 'a,always,first_only\\n' > \"$OUTPUT\""] }
}
