{
  "env": {
    "KMP_AFFINITY": "granularity=thread,balanced",
    "graphs_dir": "$root/gapbs/benchmark/graphs"
  },
  "setup": {
    "global": [],
    "point": [
      {
        "on": [
          "cxx"
        ],
        "command": "mkdir -p $root/.yuclid/bin/$machine/${yuclid.cxx}",
        "parallel": true
      },
      {
        "on": [
          "cxx",
          "program",
          "impl"
        ],
        "command": "make ${yuclid.program}_${yuclid.impl} OUTDIR=$root/.yuclid/bin/$machine/${yuclid.cxx} CXX=${yuclid.cxx}",
        "parallel": [
          "cxx",
          "program"
        ]
      }
    ]
  },
  "trials": [
    {
      "command": [
        "LD_PRELOAD=${yuclid.malloc}",
        "MALLOC_ARENA_MAX=${yuclid.narenas}",
        "MALLOC_CONF=\"narenas:${yuclid.narenas}\"",
        "OMP_NUM_THREADS=${yuclid.nthreads}",
        "burn_omp",
        "/usr/bin/time -v",
        "$root/.yuclid/bin/$machine/${yuclid.cxx}/${yuclid.program}_${yuclid.impl}.out",
        "${yuclid.input}",
        "2>&1"
      ],
      "condition": "yuclid.program in ['bc', 'bfs', 'cc', 'pr', 'sssp', 'tc']",
      "metrics": [
        "time",
        "stopwatches",
        "space"
      ]
    },
    {
      "command": [
        "LD_PRELOAD=${yuclid.malloc}",
        "MALLOC_ARENA_MAX=${yuclid.narenas}",
        "MALLOC_CONF=\"narenas:${yuclid.narenas}\"",
        "OMP_NUM_THREADS=${yuclid.nthreads}",
        "burn_omp loop $nruns",
        "/usr/bin/time -v",
        "$root/.yuclid/bin/$machine/${yuclid.cxx}/${yuclid.program}_${yuclid.impl}.out",
        "${yuclid.input}",
        "2>&1"
      ],
      "condition": "yuclid.program in ['bodytrack', 'canneal', 'dedup', 'freqmine', 'streamcluster', 'kmeans', 'kdtree', 'xz']",
      "metrics": [
        "time",
        "stopwatches",
        "space"
      ]
    },
    {
      "command": [
        "LD_PRELOAD=${yuclid.malloc}",
        "MALLOC_ARENA_MAX=${yuclid.narenas}",
        "MALLOC_CONF=\"narenas:${yuclid.narenas}\"",
        "OMP_NUM_THREADS=${yuclid.nthreads}",
        "loop $nruns",
        "/usr/bin/time -v",
        "burn_omp",
        "$root/.yuclid/bin/$machine/${yuclid.cxx}/${yuclid.program}_${yuclid.impl}.out",
        "${yuclid.input}"
      ],
      "metrics": [
        "maxrss"
      ]
    },
    {
      "command": [
        "LD_PRELOAD=$root/nmallocs/libnmallocs.so",
        "MALLOC_ARENA_MAX=${yuclid.narenas}",
        "MALLOC_CONF=\"narenas:${yuclid.narenas}\"",
        "OMP_NUM_THREADS=${yuclid.nthreads}",
        "$root/.yuclid/bin/$machine/${yuclid.cxx}/${yuclid.program}_${yuclid.impl}.out",
        "${yuclid.input}"
      ],
      "metrics": [
        "nmallocs"
      ]
    }
  ],
  "metrics": [
    {
      "name": "time",
      "command": "cat ${yuclid.@}.out | grep 'Trial' | grep -oE '[0-9]+\\.[0-9]+'",
      "condition": "yuclid.program in ['bc', 'bfs', 'cc', 'pr', 'sssp', 'tc']"
    },
    {
      "name": "time",
      "command": "cat ${yuclid.@}.out | egrep '\\[scoped_timer\\] Kernel: [0-9]+\\.[0-9]+' | awk '{ print $3 }'",
      "condition": "yuclid.program in ['kdtree', 'kmeans', 'xz']"
    },
    {
      "name": "time",
      "command": "cat ${yuclid.@}.out | egrep '\\[parsec\\] Total time spent in ROI: ' | grep -oE '[0-9]+\\.[0-9]+'",
      "condition": "yuclid.program in ['bodytrack', 'canneal', 'dedup', 'freqmine', 'streamcluster']"
    },
    {
      "name": "maxrss",
      "command": "cat ${yuclid.@}.err | grep 'Maximum resident set size (kbytes)' | grep -oE '[0-9]+'"
    },
    {
      "name": "space",
      "command": "cat ${yuclid.@}.out | grep 'Maximum resident set size (kbytes)' | grep -oE '[0-9]+'"
    },
    {
      "name": "nmallocs",
      "command": "cat ${yuclid.@}.err | grep 'nmallocs' | awk '{print $3}'"
    },
    {
      "name": "stopwatches",
      "command": "cat ${yuclid.@}.out | grep 'Trial' | grep -oE '[0-9]+\\.[0-9]+' ; cat ${yuclid.@}.out | grep stopwatch | grep 'loop.tag' | sort | awk '{print $3}'",
      "condition": "yuclid.program in ['bc', 'bfs', 'cc', 'pr', 'sssp', 'tc']"
    },
    {
      "name": "stopwatches",
      "command": "cat ${yuclid.@}.out | egrep '\\[scoped_timer\\] Kernel: [0-9]+\\.[0-9]+' | awk '{ print $3 }' ; cat ${yuclid.@}.out | grep stopwatch | grep 'loop.tag' | sort | awk '{print $3}'",
      "condition": "yuclid.program in ['kdtree', 'kmeans', 'xz']"
    },
    {
      "name": "stopwatches",
      "command": "cat ${yuclid.@}.out | egrep '\\[parsec\\] Total time spent in ROI: ' | grep -oE '[0-9]+\\.[0-9]+' ; cat ${yuclid.@}.out | grep stopwatch | grep 'loop.tag' | sort | awk '{print $3}'",
      "condition": "yuclid.program in ['bodytrack', 'canneal', 'dedup', 'freqmine', 'streamcluster']"
    }
  ],
  "space": {
    "impl": null,
    "nthreads": null,
    "cxx": [
      "clang++",
      "g++"
    ],
    "program": [
      "bc",
      "bfs",
      "bodytrack",
      "canneal",
      "cc",
      "dedup",
      "freqmine",
      "kdtree",
      "kmeans",
      "pr",
      "sssp",
      "streamcluster",
      "tc",
      "xz"
    ],
    "malloc": [
      {
        "name": "glibc",
        "value": ""
      },
      {
        "name": "jemalloc",
        "value": "libjemalloc.so"
      },
      {
        "name": "tbbmalloc",
        "value": "libtbbmalloc.so"
      }
    ],
    "narenas": null,
